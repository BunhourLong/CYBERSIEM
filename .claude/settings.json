{
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(task *)",
      "Bash(uv run *)",
      "Bash(rg *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git pull --ff-only*)",
      "Bash(git merge --ff-only *)",
      "Bash(git push *)",
      "Bash(gh run *)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)"
    ],
    "deny": [
      "Read(./**/node_modules/**)",
      "Read(./**/dist/**)",
      "Read(./**/.angular/**)",
      "Read(./**/.venv/**)",
      "Read(./**/package-lock.json)",
      "Read(./**/uv.lock)",
      "Read(./**/*.mmdb)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git add -f*)",
      "Bash(git add --force*)",
      "Bash(rm -rf *)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh" }]
      }
    ]
  }
}
