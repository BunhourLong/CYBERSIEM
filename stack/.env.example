# =============================================================================
# Cappa — Stack Environment Variables (example / template)
#
# Copy this file to .env and fill in real values before running:
#   cp .env.example .env
#   docker compose up --build -d
#
# .env is gitignored and must never be committed.
# =============================================================================


# ── Domain / Host ─────────────────────────────────────────────────────────────
# Local development → localhost
# EC2 production    → your DuckDNS or custom domain
NGINX_HOST=localhost


# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=cybersiem
POSTGRES_USER=cybersiem
POSTGRES_PASSWORD=change_me

# Must match POSTGRES_USER / PASSWORD / DB above.
DATABASE_URL=postgresql://cybersiem:change_me@postgres:5432/cybersiem


# ── Cappa (FastAPI + Security Engine) ────────────────────────────────────────

# HMAC secret for session cookies. Generate with: openssl rand -base64 32
# The API refuses to start on this placeholder or on anything under 32 bytes.
SIEM_SESSION_SECRET=change_me

# Shared secret for POST /ingest-event (Authorization: Bearer ...). Empty turns the route off.
# Generate with: openssl rand -base64 32
SIEM_INGEST_TOKEN=

SIEM_ADMIN_USERNAME=admin
# Minimum 12 characters.
SIEM_ADMIN_PASSWORD=change_me_min_12_chars

# Set to true only after HTTPS is configured.
SESSION_SECURE=false


# ── Cappa — GeoIP ─────────────────────────────────────────────────────────────
# Download GeoLite2-City.mmdb and GeoLite2-ASN.mmdb from MaxMind and place them
# in cybersiem/data/ on the host machine.
GEOIP_DB_PATH=/data/GeoLite2-City.mmdb
GEOIP_ASN_DB_PATH=/data/GeoLite2-ASN.mmdb


# ── Cappa — Nginx Paths ────────────────────────────────────────────────────────
# Container-internal paths via shared Docker volumes. Do not change.
NGINX_ACCESS_LOG=/var/log/nginx/access.log
NGINX_BLOCKLIST_PATH=/shared-nginx/blocklist.conf


# ── Cappa — IP Reputation Scoring ─────────────────────────────────────────────
# All durations are in seconds.
REPUTATION_BLOCK_DURATION_SECONDS=1800
REPUTATION_COOLDOWN_DURATION_SECONDS=1800
REPUTATION_SUPPRESS_DURATION_SECONDS=3600
REPUTATION_DECAY_PER_HOUR=8
REPUTATION_REPEATED_MEDIUM_ALERT_COUNT=3


# ── BookMark-Publisher (Express) ───────────────────────────────────────────────
EXPRESS_ADMIN_EMAIL=admin@example.com
EXPRESS_ADMIN_PASSWORD=change_me

# Set to false for hardened production deployment.
SECURITY_LAB_MODE=true

# Bearer token for /api/security/* endpoints. Generate with: openssl rand -hex 32
SECURITY_ADMIN_TOKEN=change_me

SECURITY_CONSOLE_LOG_ENABLED=true

# Rate limiting — requests per window per IP.
SECURITY_RATE_LIMIT_WINDOW_MS=60000
SECURITY_RATE_LIMIT_MAX=30

# Login failure tracking.
SECURITY_FAILED_LOGIN_THRESHOLD=4
SECURITY_FAILED_LOGIN_WINDOW_MS=300000

# Abuse scoring thresholds.
SECURITY_ABUSE_ALERT_THRESHOLD=6
SECURITY_ABUSE_BLOCK_THRESHOLD=10

# Keep false — Cappa handles blocking at nginx layer.
SECURITY_AUTO_BLOCK_ENABLED=false

SECURITY_MAX_EVENTS=500

# Serve /docs, /redoc and /openapi.json. Leave unset or false in production.
API_DOCS_ENABLED=false
